{
  "name": "pizzaorder",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/cardapio",
    "dev:cardapio": "npm run dev --workspace apps/cardapio",
    "dev:cozinha": "npm run dev --workspace apps/cozinha",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
