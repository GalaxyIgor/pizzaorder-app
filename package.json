{
  "name": "pizzaorder",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/cardapio",
    "dev:cardapio": "npm run dev --workspace apps/cardapio",
    "dev:cozinha": "npm run dev --workspace apps/cozinha",
    "dev:gestao": "npm run dev --workspace apps/gestao",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
